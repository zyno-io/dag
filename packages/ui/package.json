{
    "name": "@zyno-io/dag-ui",
    "version": "0.6.2",
    "private": true,
    "license": "MIT",
    "type": "module",
    "scripts": {
        "dev": "rimraf node_modules/.vite && vite",
        "build": "run-p typecheck build-only",
        "preview": "vite preview",
        "typecheck": "vue-tsc --noEmit -p tsconfig.app.json --composite false",
        "build-only": "vite build",
        "gen": "generate-openapi-client",
        "format": "npx oxlint --fix --fix-suggestions --fix-dangerously && oxfmt",
        "test:e2e": "playwright test",
        "test:e2e:update": "rimraf screenshots && playwright test"
    },
    "dependencies": {
        "@fontsource/inter": "^5.3.0",
        "@fortawesome/fontawesome-free": "^7.3.1",
        "@types/lodash": "^4.17.25",
        "@zyno-io/openapi-client-codegen": "^2.10.0",
        "@zyno-io/vue-foundation": "^4.37.0",
        "date-fns": "^4.4.0",
        "lodash": "^4.18.1",
        "pinia": "^4.0.3",
        "vue": "^3.5.43",
        "vue-router": "^5.3.1"
    },
    "devDependencies": {
        "@playwright/test": "^1.63.0",
        "@tailwindcss/postcss": "^4.3.3",
        "@tsconfig/node22": "^22.0.6",
        "@types/node": "^26.6.2",
        "@vitejs/plugin-vue": "^6.0.9",
        "@vue/tsconfig": "^0.9.1",
        "npm-run-all": "^4.1.5",
        "oxlint": "^1.83.0",
        "postcss": "^8.5.28",
        "rimraf": "^6.1.3",
        "sass": "^1.104.1",
        "tailwindcss": "~4",
        "typescript": "7.0.2",
        "vite": "^8.3.0",
        "vite-plugin-oxlint": "^2.2.0",
        "vue-tsc": "^3.3.11"
    }
}
